# Локальная разработка. .env никогда не коммитится (см. docs/17_CONFIGURATION.md).
# Скопируйте в .env и при необходимости поправьте.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Совпадает с infra/docker/docker-compose.dev.yml
DATABASE_URL=postgres://unichat:unichat@localhost:5432/unichat
REDIS_URL=redis://localhost:6379/0

# Только для разработки; в проде генерирует installer.
# Минимум 16 символов (zod min(16)) — короче не стартует (реаудит RA-I-9)
APP_SECRET=dev-secret-0123456789abcdef

# Одноразовый токен создания первого владельца (выводится при установке, docs/16 §4)
# SETUP_TOKEN=dev-setup-token
