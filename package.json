{
  "name": "universal-chat",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:widget-size": "node scripts/check-widget-size.mjs",
    "dev:api": "pnpm --filter @uni-chat/api dev",
    "dev:admin": "pnpm --filter @uni-chat/admin dev",
    "dev:widget": "pnpm --filter @uni-chat/widget dev",
    "dev:db": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "dev:db:down": "docker compose -f infra/docker/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.3.2",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0"
  }
}
